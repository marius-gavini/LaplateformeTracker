<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.PrimaryController">
   <children>
      <Label fx:id="welcomeLabel" text="Bienvenue" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
      <HBox spacing="20.0">
         <children>
            <VBox alignment="CENTER" fx:id="adminPanel" spacing="10.0">
               <children>
                  <Label text="Espace Admin" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
                  <Label text="Gestion des étudiants" style="-fx-font-size: 14px;" />
                  <Button text="Afficher tous les étudiants" onAction="#openStudentList" />
                  <Button text="Ajouter un nouvel étudiant" onAction="#openStudentForm" />
               </children>
            </VBox>
            <VBox fx:id="studentPanel" spacing="10.0">
               <children>
                  <Label text="Espace Étudiant" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
                  <Label text="Accédez à la liste des étudiants." />
               </children>
            </VBox>
         </children>
      </HBox>
      <Button text="Déconnexion" onAction="#logout" />
   </children>
   <padding>
      <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
   </padding>
</VBox>

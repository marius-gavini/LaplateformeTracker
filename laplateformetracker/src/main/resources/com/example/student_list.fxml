<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.StudentListController">
    <top>
        <VBox spacing="10.0">
            <padding>
                <Insets top="15.0" right="15.0" bottom="15.0" left="15.0" />
            </padding>
            <children>
                <Label text="Liste des étudiants" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                <HBox spacing="10.0">
                    <TextField fx:id="searchIdField" promptText="Rechercher par ID" prefWidth="120.0" />
                    <Button text="Rechercher ID" onAction="#searchById" />
                    <TextField fx:id="searchAgeField" promptText="Rechercher par âge" prefWidth="120.0" />
                    <Button text="Rechercher âge" onAction="#searchByAge" />
                </HBox>
                <HBox spacing="10.0">
                    <TextField fx:id="searchMinGradeField" promptText="Note min" prefWidth="80.0" />
                    <TextField fx:id="searchMaxGradeField" promptText="Note max" prefWidth="80.0" />
                    <Button text="Rechercher notes" onAction="#searchByGradeRange" />
                    <ComboBox fx:id="sortComboBox" prefWidth="120.0" />
                    <Button text="Trier" onAction="#sortStudents" />
                    <Button text="Actualiser" onAction="#refreshList" />
                    <Button text="Retour" onAction="#goBack" />
                </HBox>
                <HBox spacing="10.0">
                    <Button text="Statistiques" onAction="#showStatistics" />
                    <Button text="Exporter CSV" onAction="#exportToCSV" />
                    <Button text="Importer CSV" onAction="#importFromCSV" />
                </HBox>
            </children>
        </VBox>
    </top>
    <center>
        <TableView fx:id="studentTable">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="60.0" />
                <TableColumn fx:id="firstNameColumn" text="Prénom" prefWidth="150.0" />
                <TableColumn fx:id="lastNameColumn" text="Nom" prefWidth="150.0" />
                <TableColumn fx:id="ageColumn" text="Âge" prefWidth="80.0" />
                <TableColumn fx:id="gradeColumn" text="Note" prefWidth="100.0" />
            </columns>
        </TableView>
    </center>
    <bottom>
        <HBox spacing="10.0">
            <padding>
                <Insets top="15.0" right="15.0" bottom="15.0" left="15.0" />
            </padding>
            <children>
                <Button text="Modifier" onAction="#editSelectedStudent" />
                <Button text="Supprimer" onAction="#deleteSelectedStudent" />
                <Label fx:id="messageLabel" />
            </children>
        </HBox>
    </bottom>
</BorderPane>
